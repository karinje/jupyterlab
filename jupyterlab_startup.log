import pandas as pd
import numpy as np

# Generate synthetic data
def generate_dummy_data(num_samples=1000):
    np.random.seed(42)
    
    # Generate random data
    data = {
        'customer_id': range(1, num_samples + 1),
        'age': np.random.randint(18, 70, size=num_samples),
        'gender': np.random.choice(['Male', 'Female'], size=num_samples),
        'tenure': np.random.randint(1, 72, size=num_samples),
        'balance': np.random.uniform(0, 10000, size=num_samples),
        'products_number': np.random.randint(1, 5, size=num_samples),
        'credit_score': np.random.randint(300, 850, size=num_samples),
        'active_member': np.random.choice([0, 1], size=num_samples),
        'estimated_salary': np.random.uniform(20000, 120000, size=num_samples),
        'churn': np.random.choice([0, 1], size=num_samples, p=[0.8, 0.2])
    }
    
    return pd.DataFrame(data)

# Create the dataset
dummy_data = generate_dummy_data()
